rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Usuario principal: puede nombrar administradores y dar cualquier permiso.
    function isPrincipal() {
      return signedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email in ['josemariavasquezaguado@gmail.com', 'grupovascruzllc@gmail.com', 'josevasquezmultifamiliar@gmail.com'];
    }
    // Administradores: el principal y quienes él nombre (rol "admin").
    function isAdmin() { return isPrincipal() || (signedIn() && request.auth.token.email_verified == true && hasRol('admin')); }
    function userDoc() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function hasRol(r) { return signedIn() && exists(userDoc()) && get(userDoc()).data.rol == r; }

    // Asesores y socios: no hay registro abierto. Solo el administrador crea las fichas desde su panel
    // (como asesor o socio; el rol de administrador solo lo da el usuario principal).
    match /usuarios/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.rol in ['asesor', 'socio']
        && request.resource.data.keys().hasOnly(['nombre', 'ci', 'telefono', 'ciudad', 'empresa', 'email', 'rol', 'creado', 'creado_por']);
      // Solo el principal puede dar o quitar el rol de administrador.
      allow update, delete: if isPrincipal() || (isAdmin() && request.resource.data.rol != 'admin' && resource.data.rol != 'admin');
    }

    // Precios para asesores (precio puesto en Santa Cruz) y lista FOB para socios. Solo el administrador escribe.
    // Los socios también cotizan a nombre de Vascruz, por eso leen el precio puesto en Santa Cruz.
    match /privado/asesores { allow read: if isAdmin() || hasRol('asesor') || hasRol('socio'); allow write: if isAdmin(); }
    match /privado/socios   { allow read: if isAdmin() || hasRol('socio');  allow write: if isAdmin(); }

    // Proformas: las crea el asesor o el socio; el cliente la abre con su enlace (código no adivinable).
    match /proformas/{id} {
      allow create: if (hasRol('asesor') || hasRol('socio') || isAdmin()) && request.resource.data.asesor_uid == request.auth.uid;
      allow get: if true;
      allow list: if isAdmin() || (signedIn() && resource.data.asesor_uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
